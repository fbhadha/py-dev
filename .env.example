# Every variable the code reads, one line each, with what it is for. No values.
# This repo's scripts read no keys. Copy to .env (gitignored) if you want the line below in your shell.

# --- development tooling ----------------------------------------------------
DO_NOT_TRACK=1          # Repowise and other tools honour this; no telemetry
# coverage.lcov is what `uv run pytest --cov --cov-report=lcov:coverage.lcov` writes and
# what `uv run repowise coverage add coverage.lcov` ingests. Keep that path; it is the one way.
