{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "python3 \"${PLUGIN_ROOT}/scripts/hooks/session_start.py\"",
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "python3 \"${PLUGIN_ROOT}/scripts/hooks/guard_command.py\"",
        "timeoutSec": 5
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "python3 \"${PLUGIN_ROOT}/scripts/hooks/stop_gate.py\"",
        "timeoutSec": 60
      }
    ]
  }
}
