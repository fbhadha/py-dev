{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "f=\"${PLUGIN_ROOT}/scripts/hooks/session_start.py\"; [ -f \"$f\" ] && command -v python3 >/dev/null 2>&1 && exec python3 \"$f\"; exit 0",
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "f=\"${PLUGIN_ROOT}/scripts/hooks/guard_command.py\"; [ -f \"$f\" ] && command -v python3 >/dev/null 2>&1 && exec python3 \"$f\"; exit 0",
        "timeoutSec": 5
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "f=\"${PLUGIN_ROOT}/scripts/hooks/stop_gate.py\"; [ -f \"$f\" ] && command -v python3 >/dev/null 2>&1 && exec python3 \"$f\"; exit 0",
        "timeoutSec": 60
      }
    ]
  }
}
